# Copiez ce fichier en .env pour surcharger la configuration locale.
# .env est ignore par Git : aucun secret ne doit etre commite (malus -5).
#
# Ces valeurs par defaut suffisent pour faire tourner le projet en local et
# sont celles que docker-compose.yml applique si vous ne creez pas de .env.

POSTGRES_DB=presence48
POSTGRES_USER=presence48
POSTGRES_PASSWORD=presence48
POSTGRES_PORT=5434

# Lues par le backend Spring Boot (voir backend/src/main/resources/application.yml)
DB_URL=jdbc:postgresql://localhost:5434/presence48
DB_USER=presence48
DB_PASSWORD=presence48
